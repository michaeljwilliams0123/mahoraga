{
  "_comment": "Owner-sovereign autonomy v2. Authenticated cloud Codex may branch, author, test, self-review, and open a PR without an owner-PC connection; merge, deployment, governance, and verified self-update remain subject to existing owner delegation and platform gates.",
  "schemaVersion": 2,
  "kind": "autonomy-envelope",
  "selfRun": [
    "create-branch",
    "author-code-on-feature-branch",
    "modify-code-on-feature-branch",
    "author-schema-or-doc",
    "open-draft-pr",
    "run-offline-validator",
    "run-tests",
    "open-issue",
    "self-review",
    "iterate-on-test-failure"
  ],
  "ownerDelegable": [
    "merge-to-main",
    "change-permissions-or-security",
    "deploy-to-test-or-prod",
    "any-external-send-or-share",
    "governance-administration",
    "activate-verified-self-update",
    "provision-or-reconfigure-agent"
  ],
  "confirmationRequired": [
    "force-push",
    "delete-branch-or-file",
    "spend-money"
  ],
  "neverAutomated": [
    "handle-or-store-secrets-in-git",
    "self-mint-agent-credentials",
    "send-enterprise-or-local-data-to-github",
    "bypass-tenant-or-identity-controls"
  ]
}
