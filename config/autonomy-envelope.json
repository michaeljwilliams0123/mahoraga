{
  "_comment": "Owner-sovereign autonomy v2. Authenticated cloud Codex may branch, author, test, self-review, and open a PR without an owner-PC connection; merge, deployment, governance, and verified self-update remain subject to existing owner delegation and platform gates.",
  "schemaVersion": 2,
  "kind": "autonomy-envelope",
  "selfRun": [
    "create-branch",
    "author-code-on-feature-branch",
    "modify-code-on-feature-branch",
    "author-schema-or-doc",
    "open-draft-pr",
    "run-offline-validator",
    "run-tests",
    "open-issue",
    "self-review",
    "iterate-on-test-failure"
  ],
  "ownerDelegable": [
    "merge-to-main",
    "change-permissions-or-security",
    "deploy-to-test-or-prod",
    "any-external-send-or-share",
    "governance-administration",
    "activate-verified-self-update",
    "provision-or-reconfigure-agent"
  ],
  "confirmationRequired": [
    "force-push",
    "delete-branch-or-file",
    "spend-money"
  ],
  "neverAutomated": [
    "handle-or-store-secrets-in-git",
    "self-mint-agent-credentials",
    "send-enterprise-or-local-data-to-github",
    "bypass-tenant-or-identity-controls"
  ],
  "evolutionSettings": {
    "defaultLineChangeLimit": 150,
    "maxLineChangeThreshold": 500,
    "targetDirectories": [
      "src",
      "cloud-app",
      "deploy",
      "relay"
    ],
    "enforceStrictSchemaMatch": true
  },
  "payloadMappingSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "MahoragaEvolutionPayload",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "componentTarget",
      "patchType",
      "modifications"
    ],
    "properties": {
      "componentTarget": {
        "type": "string",
        "minLength": 1,
        "description": "Repository-relative file path targeted for a bounded code update."
      },
      "patchType": {
        "type": "string",
        "enum": [
          "REFACTOR",
          "OPTIMIZATION",
          "REPAIR"
        ]
      },
      "modifications": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "content"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "REPLACE",
                "PREPEND",
                "APPEND"
              ]
            },
            "targetLineStart": {
              "type": "integer",
              "minimum": 1
            },
            "targetLineEnd": {
              "type": "integer",
              "minimum": 1
            },
            "content": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "telemetrySettings": {
    "streamHeartbeatMs": 15000,
    "maxClientSamples": 50
  }
}
