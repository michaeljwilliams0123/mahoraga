{
  "_comment": "Reference configuration for maximum-safe autonomy. Self-run covers the full build-and-propose loop; gated covers only destructive/external/authority actions; neverAutomated is structurally fixed.",
  "schemaVersion": 1,
  "kind": "autonomy-envelope",
  "selfRun": [
    "create-branch",
    "author-code-on-feature-branch",
    "modify-code-on-feature-branch",
    "author-schema-or-doc",
    "open-draft-pr",
    "run-offline-validator",
    "run-tests",
    "open-issue",
    "self-review",
    "iterate-on-test-failure"
  ],
  "gated": [
    "merge-to-main",
    "force-push",
    "delete-branch-or-file",
    "change-permissions-or-security",
    "deploy-to-test-or-prod",
    "spend-money",
    "any-external-send-or-share"
  ],
  "neverAutomated": [
    "handle-or-store-secrets-in-git",
    "self-mint-agent-credentials",
    "send-enterprise-or-local-data-to-github",
    "bypass-tenant-or-identity-controls"
  ]
}
