# Enforce LF line endings for all files across all platforms
* text=auto eol=lf

# JavaScript/Node files
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Binary files (don't convert)
*.png binary
*.jpg binary
*.gif binary
*.zip binary
*.tar binary
