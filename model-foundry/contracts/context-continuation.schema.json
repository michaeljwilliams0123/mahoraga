{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MahoragaNativeContextContinuationManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "modelId",
    "architectureVersion",
    "tokenizerVersion",
    "tokenizerDigest",
    "trainingDataManifest",
    "evaluationDataManifest",
    "dataRightsManifest",
    "trainingCodeSha",
    "trainingConfigurationSha",
    "optimizer",
    "learningRateSchedule",
    "trainingRunId",
    "evaluationSuite",
    "promotionStatus",
    "schemaVersion",
    "initializationSeed",
    "parameterCount",
    "trainingTokens",
    "creditCost",
    "parentModel",
    "rollbackCheckpoint",
    "knownLimitations",
    "productionActivated",
    "seed",
    "epochs",
    "contextLength",
    "embeddingSize",
    "hiddenSize",
    "trainingExamples",
    "evaluationExamples",
    "learningRate",
    "rootCheckpoint",
    "generation",
    "trainingHistory",
    "evaluationHistory"
  ],
  "properties": {
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "architectureVersion": {
      "type": "string",
      "enum": [
        "single-head-causal-context-v1"
      ]
    },
    "tokenizerVersion": {
      "type": "string",
      "enum": [
        "unicode-character-v1"
      ]
    },
    "tokenizerDigest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "trainingDataManifest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "evaluationDataManifest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "dataRightsManifest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "trainingCodeSha": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "trainingConfigurationSha": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "optimizer": {
      "type": "string",
      "enum": [
        "sgd-cross-entropy-clipped-v1"
      ]
    },
    "learningRateSchedule": {
      "type": "string",
      "enum": [
        "constant"
      ]
    },
    "trainingRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "evaluationSuite": {
      "type": "string",
      "enum": [
        "disjoint-context-last-token-v1"
      ]
    },
    "promotionStatus": {
      "type": "string",
      "enum": [
        "candidate"
      ]
    },
    "schemaVersion": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "initializationSeed": {
      "type": "integer",
      "minimum": 0
    },
    "parameterCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16384
    },
    "trainingTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "creditCost": {
      "type": "integer",
      "enum": [
        0
      ]
    },
    "parentModel": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "rollbackCheckpoint": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "knownLimitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "productionActivated": {
      "type": "boolean",
      "enum": [
        false
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "epochs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "contextLength": {
      "type": "integer",
      "minimum": 2,
      "maximum": 8
    },
    "embeddingSize": {
      "type": "integer",
      "minimum": 4,
      "maximum": 16
    },
    "hiddenSize": {
      "type": "integer",
      "minimum": 4,
      "maximum": 32
    },
    "trainingExamples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "evaluationExamples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "learningRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.25
    },
    "rootCheckpoint": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "trainingHistory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "contentDigest",
          "contextDigest",
          "rights",
          "rightsEvidenceDigest"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "rights": {
            "type": "string",
            "enum": [
              "owner-authorized",
              "public-domain",
              "permissive-license"
            ]
          },
          "contentDigest": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "contextDigest": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "rightsEvidenceDigest": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    },
    "evaluationHistory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "contentDigest",
          "contextDigest",
          "rights",
          "rightsEvidenceDigest"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "rights": {
            "type": "string",
            "enum": [
              "owner-authorized",
              "public-domain",
              "permissive-license"
            ]
          },
          "contentDigest": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "contextDigest": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "rightsEvidenceDigest": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    }
  }
}
