FROM node:24-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production MAHORAGA_RUNTIME_PORT=4783

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY src ./src
COPY config ./config
COPY mahoraga.manifest.json ./

RUN mkdir -p /app/state && chown -R node:node /app
USER node
EXPOSE 4783

CMD ["npm", "start"]
