#!/bin/sh
zero=0000000000000000000000000000000000000000

node_command=""
if command -v node >/dev/null 2>&1; then
  node_command="node"
elif [ -n "$USERPROFILE" ]; then
  bundled_node="$USERPROFILE\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\node\\bin\\node.exe"
  if [ -f "$bundled_node" ]; then node_command="$bundled_node"; fi
fi

if [ -z "$node_command" ]; then
  echo "Mahoraga coordination guard: Node.js 24+ was not found." >&2
  exit 1
fi

"$node_command" scripts/coordination.mjs validate || exit 1

while read local_ref local_sha remote_ref remote_sha
do
  case "$remote_ref" in
    refs/heads/main|refs/heads/agent/mahoraga-3-1-production-workers)
      if [ "$local_sha" = "$zero" ]; then
        echo "Mahoraga history guard: protected branch deletion is blocked." >&2
        exit 1
      fi
      if [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
        echo "Mahoraga history guard: non-fast-forward updates are blocked." >&2
        exit 1
      fi
      ;;
  esac
done

exit 0
