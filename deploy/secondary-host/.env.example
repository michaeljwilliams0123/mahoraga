# Copy this file to .env and provide real values outside Git.
# Every image must be pinned to an immutable digest.

# Required immutable images
N8N_IMAGE=docker.n8n.io/n8nio/n8n@sha256:replace_with_real_digest
QDRANT_IMAGE=qdrant/qdrant@sha256:replace_with_real_digest
MCP_GATEWAY_IMAGE=ghcr.io/example/mcp-gateway@sha256:replace_with_real_digest
OLLAMA_IMAGE=ollama/ollama@sha256:replace_with_real_digest
ENV_INIT_IMAGE=alpine@sha256:replace_with_real_digest

# Required secrets (inject from a secret manager)
N8N_ENCRYPTION_KEY=replace_with_32_plus_char_random_secret
QDRANT_API_KEY=replace_with_qdrant_api_key
MCP_ALLOWED_SERVERS=github,gitlab,vercel

# Network bindings (loopback by default; set 0.0.0.0 only with explicit review)
N8N_BIND_HOST=127.0.0.1
QDRANT_BIND_HOST=127.0.0.1
MCP_GATEWAY_BIND_HOST=127.0.0.1

# Service ports
N8N_PORT=5678
MCP_GATEWAY_PORT=8080

# n8n runtime settings
N8N_HOST=127.0.0.1
N8N_IMPORT_ON_BOOT=true

# LLM endpoint propagation
# Default uses host.docker.internal so Apple Silicon and Docker Desktop can reuse a host Ollama runtime.
# When running one of the local Ollama profiles, prefer http://ollama-cpu:11434, http://ollama-gpu-nvidia:11434, or http://ollama-gpu-amd:11434.
N8N_AI_OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_KEEP_ALIVE=10m

# Optional gateway health endpoint override
MCP_GATEWAY_HEALTH_PATH=/healthz

# Profile examples:
# CPU local AI:          docker compose --env-file .env --profile cpu up -d
# NVIDIA GPU local AI:   docker compose --env-file .env --profile gpu-nvidia up -d
# AMD GPU local AI:      docker compose --env-file .env --profile gpu-amd up -d
# Secondary baseline:    docker compose --env-file .env up -d
