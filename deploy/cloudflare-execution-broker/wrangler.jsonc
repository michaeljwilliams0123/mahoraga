{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mahoraga-execution-broker",
  "main": "worker.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "CLOUD_PROVIDER",
      "service": "mahoraga-cloud-inspection-provider"
    }
  ]
}
