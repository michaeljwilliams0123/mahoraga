{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mahoraga-cloudflare-readonly-inspector",
  "main": "worker.ts",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "secrets": { "required": ["CLOUDFLARE_AUDIT_TOKEN", "CLOUDFLARE_ACCOUNT_ID"] },
  "observability": { "enabled": true }
}
