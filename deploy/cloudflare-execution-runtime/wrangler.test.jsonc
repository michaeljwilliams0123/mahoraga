{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mahoraga-execution-runtime-test",
  "main": "worker.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "MEMORY_DB", "database_name": "mahoraga-memory-db", "database_id": "8faed08c-8bc9-4b0e-94f6-ab956c5ec12a" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "EXECUTION_DO", "class_name": "ExecutionDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ExecutionDurableObject"] }
  ]
}
