{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mahoraga-zero-credit-inference",
  "main": "worker.ts",
  "compatibility_date": "2026-09-23",
  "ai": { "binding": "AI" },
  "secrets": {
    "required": ["TARGET_SHA", "ZERO_CREDIT_ACCOUNT_ID_HASH", "ZERO_CREDIT_PROVIDER_TOKEN"]
  },
  "observability": { "enabled": true }
}
