{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mahoraga-zero-credit-inference",
  "main": "worker.ts",
  "compatibility_date": "2026-09-23",
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "BUDGET_DO", "class_name": "ZeroCreditBudgetDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ZeroCreditBudgetDO"] }
  ],
  "secrets": {
    "required": ["ZERO_CREDIT_PROVIDER_TOKEN"]
  },
  "observability": { "enabled": true }
}
